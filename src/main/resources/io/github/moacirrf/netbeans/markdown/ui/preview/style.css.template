body {
    padding: 0px 15px 15px 15px;
    margin: 0px;
    color: ${body.color};
    background-color: ${body.bgColor};
}

p, h1, h2, h3, h4, h5, h6, a, code, pre, table, li {
    font-family: ${fontFamily};
}

p, a, code, pre, table, li {
    font-size: ${fontSize};
}

p, dl, blockquote, pre, table {
    margin-top: 0px;
    margin-bottom: 10px;
}

p {
    font-weight: normal;
}

h1, h2 {
    font-weight: bold;
    margin-top: 10px;
    margin-bottom: 6px;
}

h3, h4, h5, h6 {
    font-weight: bold;
    margin-top: 8px;
    margin-bottom: 5px;
}

h1 {
    font-size: ${h1.fontSize}pt;
}

h2 {
    font-size: ${h2.fontSize}pt;
}

h3 {
    font-size: ${h3.fontSize}pt;
}

h4 {
    font-size: ${h4.fontSize}pt;
}

h5 {
    font-size: ${h5.fontSize}pt;
}

h6 {
    font-size: ${h6.fontSize}pt;
}

strong {
    font-weight: bold;
}

em {
    font-style: italic;
}

blockquote {
    border-left-style: solid;
    border-left-width: 3px;
    margin-left: 0px;
    margin-right: 0px;
    padding-top: 10px;
    padding-right: 15px;
    padding-bottom: 0px;
    padding-left: 15px;
    background-color: ${blockquote.bgColor};
    border-left-color: ${blockquote.borderLeftColor};
}

ol, ul {
    margin-top: 0px;
    margin-bottom: 7px;
    margin-left: 20px;
    padding: 0px;
}

ul {
    list-style-type: disc;
}

ol {
    list-style-type: decimal;
}

ol ol, ol ul, ul ol, ul ul {
    margin-top: 3px;
    margin-bottom: 0px;
    padding: 0px;
}

ol ol {
    list-style-type: upper-roman;
}

ul ul, ol ul {
    list-style-type: circle;
}

li {
    margin-top: 0px;
    margin-bottom: 3px;
    margin-left: 0px;
    margin-right: 0px;
    padding: 0px;
}

li p {
    margin-top: 0px;
    margin-bottom: 6px;
}

li pre, li blockquote, li table {
    margin-top: 6px;
    margin-bottom: 6px;
}

pre {
    padding: 10px 44px 10px 15px;
    background-color: ${pre.bgColor};
}

pre code {
    background-color: ${pre.bgColor};
}

a {
    color: #6897bb;
    text-decoration: underline;
}

table {
    border-spacing: 0px;
}

td, th {
    border-style: solid;
    border-width: 1px;
    padding: 10px;
    border-color: ${tdTh.borderColor};
}

th {
    font-weight: bold;
}

code {
    background-color: ${code.bgColor};
}

.noBorderTop {
    border-top-width: 0px;
}

.noBorderLeft {
    border-left-width: 0px;
}

.noBorderTopLeft {
    border-top-width: 0px;
    border-left-width: 0px;
}

.removeColorLinkWithImage {
    color: ${removeColorLinkWithImage.color};
}

.removeMarginPaddingTop {
    margin-top: 0px;
}

.task-list-item {
    list-style-type: none;
}